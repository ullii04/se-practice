@startuml
left to right direction

class Student {
  - studentId: String
  - name: String
  + viewAvailability(startTime, endTime)
  + bookRoom(room, startTime, endTime)
  + cancelBooking(booking)
}

class Room {
  - roomId: String
  - name: String
  - blocked: Boolean
  + block()
  + unblock()
  + isAvailable(startTime, endTime): Boolean
}

class Booking {
  - bookingId: String
  - startTime: DateTime
  - endTime: DateTime
  - status: String
  + cancel()
  + duration(): Duration
}

class Administrator {
  - administratorId: String
  - name: String
  + blockRoom(room)
  + unblockRoom(room)
  + reviewUsage()
}

Student "1" -- "0..*" Booking : makes
Room "1" -- "0..*" Booking : reserved for

Administrator "0..*" -- "0..*" Room : manages

note right of Booking
R1: startTime must be in the future.
Duration must be > 0 and <= 2 hours.

R2: Active bookings for the same
Room must not overlap.

R4: A successful booking produces
a confirmation.
end note

note right of Room
R3: A blocked Room cannot accept
a new Booking.
end note

@enduml